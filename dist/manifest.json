{
  "manifest_version": 3,

  "name": "SweetBonanza Judol Detector",
  "version": "1.0",
  "permissions": ["storage"],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
